# Google OAuth
# Get this from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Apple OAuth
# Get this from: https://developer.apple.com/account/
NEXT_PUBLIC_APPLE_TEAM_ID=your_apple_team_id_here
NEXT_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id_here
NEXT_PUBLIC_APPLE_RETURN_URL=http://localhost:3000/api/auth/apple/callback

# API
MONGODB_URI=your_mongodb_connection_string_here

# JWT
JWT_SECRET=your_jwt_secret_here
